{{> welcome-menu active="signup"}}

<section class="section">
    <h1 class="title">Sign up</h1>
        <form action="/register" method="POST">
            <label for="" class="label">Name</label>
            <div class="field is-horizontal">
                <div class="field-body">
                    <div class="field">
                        <input type="text" class="input" placeholder="Enter first name" name="firstName">
                    </div>
                    <div class="field">
                        <input type="text" class="input" placeholder="Enter last name" name="lastName">
                    </div>
                </div>
            </div>
            <div class="field">
                <label class="label">Email</label>
                <input type="text" class="input" placeholder="Enter email" name="email">
            </div>
             <div class="field">
                <label class="label">Password</label>
                <input type="text" class="input" placeholder="Enter password" name="password">
            </div>
            <div class="field is-grouped">
                <button class="button is-link">Submit</button>
            </div>
        </form>
</section>